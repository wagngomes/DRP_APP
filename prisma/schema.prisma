// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---------------------------------------------------------------------------
// Tabelas de importação de CSV (Task_02_imports_models_routes_page)
// Todas as colunas são opcionais pois vêm de CSVs externos (dados podem faltar).
// Colunas de "codigo" de produto usam relação lógica (mesmo tipo, indexada,
// sem FK) com Produtos.codigo — CSVs de tabelas diferentes podem ser
// importados em qualquer ordem sem depender de integridade referencial.
// ---------------------------------------------------------------------------

model Produtos {
  codigo           String   @id
  createdAt        DateTime @default(now())
  descricao        String?
  tipo             String?
  unidade          String?
  cod_barras       String?
  cod_fabrica      String?
  cod_marca        String?
  marca            String?
  grp_marca        String?
  d_grp_marca      String?
  grupo            String?
  tag_medic        String?
  tipo_medicamento String?
  principio_ativo  String?
  usa_refrig       String?

  @@map("produtos")
}

model Fiscal {
  id               Int      @id @default(autoincrement())
  createdAt        DateTime @default(now())
  codigo           String?
  segmento_pricing String?
  categoria_gc     String?
  classe           String?
  ean              String?
  uf_fornecedor    String?
  tributacao       String?

  // Sem chave estrangeira para Produtos de propósito. A relação existia com
  // `onDelete: SetNull`, e como o import de Produtos apaga a tabela antes de
  // inserir, cada atualização do catálogo zerava `codigo` em cascata nestes
  // snapshots — silenciosamente, porque SetNull não é erro. Snapshot é registro
  // histórico e não pode ser mutado quando o catálogo muda. A validação de
  // produto inexistente continua existindo, no import (`references` em
  // src/lib/imports/config.ts), que é onde ela consegue reportar as linhas
  // ignoradas para o usuário.

  @@index([codigo])
  @@map("fiscal")
}

model Filiais {
  // `codigo` é a chave natural do cadastro, como em Produtos e Rotas: dispensa
  // id artificial e faz o import descartar linhas repetidas do próprio CSV.
  codigo    String   @id
  createdAt DateTime @default(now())
  sigla     String?
  descricao String?

  @@map("filiais")
}

model Fornecedores {
  // Nome como vem nas bases de origem — chave natural, igual a Produtos e
  // Filiais: dispensa id artificial e o import descarta repetições do CSV.
  fornecedor             String   @id
  createdAt              DateTime @default(now())
  /**
   * Nome padronizado, usado em toda a aplicação.
   */
  fornecedor_normalizado String?

  @@index([fornecedor_normalizado])
  @@map("fornecedores")
}

model CenarioSalvo {
  // Cenário hipotético analisado, guardado para consulta posterior.
  //
  // O JSON em `resultado` é o retrato completo do que a tela mostrou: os
  // números do motor **e** o texto que a IA escreveu sobre eles. Recalcular ao
  // reabrir produziria outro texto e outros números, e a análise deixaria de
  // ser o que o usuário leu quando decidiu — por isso é retrato, não consulta
  // ao vivo.
  //
  // Os campos soltos ao lado existem só para o card da lista: sem eles, montar
  // a lista exigiria abrir e percorrer o JSON de cada análise.
  id                String   @id @default(cuid())
  createdAt         DateTime @default(now())
  fornecedor        String
  pergunta          String
  data_base         DateTime @db.Date
  data_entrada      DateTime @db.Date
  rompem            Int
  dias_descobertos  Int
  unidades_faltando Int
  resultado         Json

  @@index([createdAt])
  @@map("cenario_salvo")
}

model AnaliseIa {
  // Análise gerada pelo modelo, gravada por data de referência.
  //
  // `resultado` guarda o texto **e** os números que o sustentavam no momento da
  // geração. Mostrar texto antigo ao lado de números recalculados produziria uma
  // tela incoerente — a análise é um retrato, não uma visão ao vivo.
  //
  // `entrada_hash` é o hash do dossiê: quando o dossiê atual diverge, a tela
  // avisa que a análise envelheceu, sem apagar a anterior.
  id             Int      @id @default(autoincrement())
  createdAt      DateTime @default(now())
  data_snapshot  DateTime @db.Date
  modelo         String
  parametros     Json
  resultado      Json
  entrada_hash   String
  tokens_entrada Int      @default(0)
  tokens_saida   Int      @default(0)

  @@index([data_snapshot, createdAt])
  @@map("analise_ia")
}

model LeadTimeFornecedor {
  // Dias entre a colocação do pedido e a entrega no CD — o trecho que o SLA não
  // cobre, já que `sla_transferencias` só descreve o percurso entre centros.
  //
  // Por (fornecedor, cd) e não só por fornecedor: o mesmo fornecedor entrega em
  // prazos diferentes conforme o centro. Nos dados atuais, 236 dos 375 pares
  // têm prazo único, contra apenas 40 dos 107 fornecedores.
  //
  // Cadastro próprio porque o `lt` de pedidos_de_compra é negociado por pedido e
  // varia dentro do mesmo fornecedor (CREMER vai de 15 a 34 dias); aquela coluna
  // serve como conferência, não como fonte.
  //
  // Substituição completa no import, como SLA e Filiais: o arquivo é a fonte de
  // verdade e a chave é composta, o que o upsert por campo único não cobriria.
  id         Int      @id @default(autoincrement())
  createdAt  DateTime @default(now())
  fornecedor String
  cd         String
  lead_time  Int?

  @@unique([fornecedor, cd])
  @@map("lead_time_fornecedor")
}

model Rotas {
  codigo_rota      String   @id
