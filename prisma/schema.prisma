  @@index([data])
  // Composto para as consultas de um item só (curva diária, clientes do item).
  @@index([cod_prod, data])
  // ATENÇÃO: existe um terceiro índice que o Prisma não sabe declarar —
  // expressão sobre EXTRACT(day FROM data) com INCLUDE das colunas agregadas.
  // É ele que transforma a leitura da janela em Index Only Scan (1,9s -> 0,46s).
  // Fica em prisma/indices.sql e precisa ser reaplicado depois de um db push,
  // que apaga índices ausentes do schema.
  @@map("historico_vendas")
}

model TarefaCockpit {
  // Uma tarefa do checklist do cockpit marcada como feita.
  //
  // A presença da linha é o "ok": desmarcar apaga. Não há coluna booleana
  // porque a esmagadora maioria das posições nunca é marcada — guardar uma
  // linha `false` para cada uma das 1.340 ações de cada dia seria carregar o
  // peso do que não aconteceu.
  //
  // Marcação compartilhada, com autor: a fila é da equipe, e quem já cobrou um
  // fornecedor precisa que o colega veja isso em vez de ligar de novo. Por isso
  // `concluida_por` guarda o nome — a informação útil é quem tratou, não apenas
  // que alguém tratou.
  //
  // Presa à data de referência: o checklist é do dia. Um item que continuar
  // crítico amanhã reaparece desmarcado, que é o comportamento certo — a
  // cobrança de ontem não resolve a ruptura de hoje.
  id            Int      @id @default(autoincrement())
  data_snapshot DateTime @db.Date
  codigo        String
  filial        String
  /**
   * Ação vigente quando foi marcada — permite ver depois o que foi feito.
   */
  acao          String
  concluida_em  DateTime @default(now())
  concluida_por String

  @@unique([data_snapshot, codigo, filial])
  @@index([data_snapshot])
  @@map("tarefa_cockpit")
}
