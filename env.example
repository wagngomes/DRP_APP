# Variáveis de ambiente do DRP_AI.
#
#   cp env.example .env
#
# Sem o ponto no começo do nome de propósito: o .gitignore ignora todo `.env*`,
# e a regra do projeto é não versionar nenhum arquivo com esse prefixo. Como
# este é o modelo que precisa viajar no repositório — é dele que sai o `.env`
# da VPS — ele fica de fora do padrão em vez de abrir exceção na regra.
#
# Aqui só entram chaves e valores de exemplo. Nenhum segredo real.

# --- Banco de dados -----------------------------------------------------------
# Com docker compose, o host é o nome do serviço: `banco`.
DATABASE_URL="postgresql://drp:drp_local@localhost:5432/drp_ai"

# --- Autenticação -------------------------------------------------------------
# Segredo de assinatura da sessão. Gere um novo por ambiente:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Quem pode criar conta. O formulário de cadastro é público, e confirmar o
# e-mail prova que a caixa existe — não que a pessoa é da empresa. Vazio libera
# qualquer domínio, o que só faz sentido em desenvolvimento.
#   EMAIL_DOMINIOS_PERMITIDOS="suaempresa.com.br"
EMAIL_DOMINIOS_PERMITIDOS=""

# Exigir e-mail confirmado antes do primeiro login.
# Só ligue depois de o domínio estar verificado no Resend: com o remetente de
# sandbox (onboarding@resend.dev) a mensagem só chega ao dono da conta Resend, e
# todo mundo mais fica trancado do lado de fora sem erro visível.
EXIGIR_EMAIL_VERIFICADO="false"

# --- E-mail transacional (opcional) -------------------------------------------
RESEND_API_KEY=""
# Depois de verificar o domínio no Resend, troque para um endereço dele:
#   EMAIL_FROM="DRP_AI <nao-responda@suaempresa.com.br>"
EMAIL_FROM=""

# --- Análise por IA (opcional) ------------------------------------------------
# Sem esta chave os cálculos continuam funcionando; o que some é o texto das
# análises no cockpit e na tela de cenários.
ANTHROPIC_API_KEY=""

# --- docker compose -----------------------------------------------------------
POSTGRES_USER="drp"
POSTGRES_PASSWORD="drp_local"
POSTGRES_DB="drp_ai"
APP_PORT="3000"

# Painel do Grafana, no perfil `observabilidade`.
GRAFANA_USER="admin"
# TROQUE ANTES DE SUBIR se for usar o perfil de observabilidade: o Grafana
# expõe os dados de operação do sistema.
GRAFANA_PASSWORD="admin"
GRAFANA_PORT="3001"

# --- Backup -------------------------------------------------------------------
# Retenção em dias e intervalo entre dumps (86400 = 24h).
BACKUP_RETENCAO_DIAS="14"
BACKUP_INTERVALO_SEGUNDOS="86400"
